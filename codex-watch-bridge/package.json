{
  "name": "codex-watch-bridge",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Bridge between Codex desktop local data and Wear OS watch app (M1)",
  "scripts": {
    "build": "tsc",
    "bridge": "node --experimental-sqlite --no-warnings dist/index.js",
    "bridge:demo": "node --experimental-sqlite --no-warnings dist/index.js --demo",
    "client": "node dist/client.js",
    "dev": "npm run build && npm run bridge",
    "test:mcp": "node scripts/test-mcp.mjs"
  },
  "dependencies": {
    "bonjour-service": "^1.4.4",
    "selfsigned": "^5.5.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/ws": "^8.5.13",
    "typescript": "^5.7.0"
  }
}
